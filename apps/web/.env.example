# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web)
# Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional: only allow sign-in from this Google Workspace domain, e.g. yourco.com
ALLOWED_EMAIL_DOMAIN=
# Optional: Google OAuth. Leave blank to use email/password only.
# AUTH_DEV_LOGIN is unused; accounts are created on /signup.
# Where the Express API runs
API_URL=http://127.0.0.1:4000
# Must match API_JWT_SECRET in apps/api/.env
API_JWT_SECRET=change-me-to-a-long-random-string
