# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web)
# Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional: only allow sign-in from this Google Workspace domain, e.g. yourco.com
ALLOWED_EMAIL_DOMAIN=
# Local only: shows an email-only sign-in form so you can try the app without Google
AUTH_DEV_LOGIN=true
# Where the Express API runs
API_URL=http://localhost:4000
# Must match API_JWT_SECRET in apps/api/.env
API_JWT_SECRET=change-me-to-a-long-random-string
