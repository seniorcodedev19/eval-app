# Postgres (local docker-compose default shown)
DATABASE_URL=postgres://eval:eval@localhost:5432/eval
# Must match API_JWT_SECRET in apps/web/.env.local
API_JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated emails that are always admins (bootstrap)
ADMIN_EMAILS=you@example.com
# Browser origin allowed to call the API directly (the web app proxies, so this is optional)
WEB_ORIGIN=http://localhost:3000
PORT=4000
