# Local docker-compose default, or a Supabase URI (Settings > Database).
DATABASE_URL=postgres://eval:eval@localhost:5432/eval
# Supabase session/direct URI (port 5432). Used by migrate and seed. Falls back to DATABASE_URL.
# DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Force SSL on/off. Remote hosts (including Supabase) use SSL by default; localhost does not.
# DATABASE_SSL=true
# Must match API_JWT_SECRET in apps/web/.env.local
API_JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated emails that are always admins (bootstrap)
ADMIN_EMAILS=kherrmann9319@gmail.com
# Browser origin allowed to call the API directly (the web app proxies, so this is optional)
WEB_ORIGIN=http://localhost:3000
PORT=4000

# Slack agent (admin installs once). Never put these in apps/web.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Optional. Encrypts Slack / OpenAI keys at rest. Falls back to API_JWT_SECRET if unset.
AGENT_TOKEN_SECRET=
# From api.slack.com/apps → your app → Basic Information
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Thin @eval bot: Events replies as the app. Never used for search/history.
SLACK_BOT_TOKEN=
# Socket Mode for local Events without a public URL (xapp-…). Also saveable on Admin → Agent connect.
SLACK_APP_TOKEN=
# User OAuth redirect. Must match the Slack app config.
SLACK_REDIRECT_URI=http://localhost:3000/api/slack/callback
# Public API origin for Slack Event Subscriptions (prod). Local defaults to http://localhost:4000.
# API_PUBLIC_URL=https://your-api.example.com
# SLACK_EVENTS_URL=https://your-api.example.com/agent/slack/events
